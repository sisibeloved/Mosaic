{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/floor.granted.schema.json",
  "title": "FloorGrantedPayload",
  "description": "FloorGrant 签发：意愿放行记账（RFC-0012）；epoch 用于迟到拒绝（AR-004/AR-008）。 v1.38：response_cap 随 token 成本门控退役移除（成本只统计不影响主线）。",
  "type": "object",
  "required": [
    "grant_id",
    "round_id",
    "participant_id",
    "rank",
    "context_watermark",
    "epoch",
    "expires_at",
    "directed"
  ],
  "additionalProperties": false,
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^grant_[0-9A-Za-z_-]+$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^rnd_[0-9A-Za-z_-]+$"
    },
    "participant_id": {
      "type": "string",
      "pattern": "^par_[0-9A-Za-z_-]+$"
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "context_watermark": {
      "type": "integer",
      "minimum": 0
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "directed": {
      "type": "boolean",
      "description": "true 表示来自点名/定向交锋快速通道（3.1.9）"
    }
  }
}
