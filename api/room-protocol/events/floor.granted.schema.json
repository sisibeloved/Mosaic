{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/floor.granted.schema.json",
  "title": "FloorGrantedPayload",
  "description": "FloorGrant 签发：含 rank 与 reveal_strategy；epoch 用于迟到拒绝（AR-004/AR-008）；生成结果提交以消费 grant 为准。",
  "type": "object",
  "required": [
    "grant_id", "round_id", "participant_id", "rank", "reveal_strategy",
    "context_watermark", "epoch", "expires_at", "response_cap", "directed"
  ],
  "additionalProperties": false,
  "properties": {
    "grant_id": { "type": "string", "pattern": "^grant_[0-9A-Za-z_-]+$" },
    "round_id": { "type": "string", "pattern": "^rnd_[0-9A-Za-z_-]+$" },
    "participant_id": { "type": "string", "pattern": "^par_[0-9A-Za-z_-]+$" },
    "rank": { "type": "integer", "minimum": 1 },
    "reveal_strategy": {
      "type": "string",
      "enum": ["sequential", "simultaneous", "independent_then_cross"]
    },
    "context_watermark": { "type": "integer", "minimum": 0 },
    "epoch": { "type": "integer", "minimum": 1 },
    "expires_at": { "type": "string", "format": "date-time" },
    "response_cap": { "type": "integer", "minimum": 1 },
    "directed": {
      "type": "boolean",
      "description": "true 表示来自点名/定向交锋快速通道（3.1.9）"
    }
  }
}
