{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/round.closed.schema.json",
  "title": "RoundClosedPayload",
  "description": "反应波关闭（RFC-0012：quiescent=意愿静默终止——全员选择不回，流自然结束）。",
  "type": "object",
  "required": [
    "round_id",
    "outcome",
    "selected_count",
    "silent_count"
  ],
  "additionalProperties": false,
  "properties": {
    "round_id": {
      "type": "string",
      "pattern": "^rnd_[0-9A-Za-z_-]+$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "published",
        "quiescent"
      ]
    },
    "selected_count": {
      "type": "integer",
      "minimum": 0
    },
    "silent_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
