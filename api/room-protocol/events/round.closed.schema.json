{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/round.closed.schema.json",
  "title": "RoundClosedPayload",
  "description": "Round 生命周期关闭：一轮可产生零公开发言（合法结果而非错误，AR-002）。",
  "type": "object",
  "required": ["round_id", "outcome", "selected_count", "silent_count", "cross_subrounds"],
  "additionalProperties": false,
  "properties": {
    "round_id": { "type": "string", "pattern": "^rnd_[0-9A-Za-z_-]+$" },
    "outcome": {
      "type": "string",
      "enum": ["published", "quiescent", "budget_stopped", "revoked_all"]
    },
    "selected_count": { "type": "integer", "minimum": 0 },
    "silent_count": { "type": "integer", "minimum": 0 },
    "cross_subrounds": { "type": "integer", "minimum": 0 }
  }
}
