{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/doc.archived.schema.json",
  "title": "DocArchivedPayload",
  "description": "文档归档（RFC-0014 §2.8 生命周期：active → archived；归档不删内容，可 restored 恢复）。",
  "type": "object",
  "required": ["doc_id"],
  "additionalProperties": false,
  "properties": {
    "doc_id": { "type": "string", "pattern": "^doc_[0-9a-f]{12}$" }
  }
}
