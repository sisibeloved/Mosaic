{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/evidence_request.created.schema.json",
  "title": "EvidenceRequestCreatedPayload",
  "description": "证据需求单创建（RFC-0005 §3.1.9 / M3-5）：争议依赖外部事实；owners 空=人类待认领。",
  "type": "object",
  "required": [
    "request_id",
    "question",
    "required_evidence",
    "acceptance_criteria",
    "owners",
    "reopen_thread_on_resolution"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^ereq_[0-9A-Za-z_-]+$"
    },
    "claim_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reopen_thread_on_resolution": {
      "type": "boolean"
    }
  }
}
