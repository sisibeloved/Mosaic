{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/closure.rejected.schema.json",
  "title": "ClosureRejectedPayload",
  "description": "合格异议中止收束（线程回 active，人类可再次提议）。",
  "type": "object",
  "required": [
    "closure_id",
    "qualified_objection",
    "reason",
    "phase_to"
  ],
  "additionalProperties": false,
  "properties": {
    "closure_id": {
      "type": "string",
      "pattern": "^clo_[0-9A-Za-z_-]+$"
    },
    "qualified_objection": {
      "type": "string",
      "pattern": "^evt_[0-9A-Za-z_-]+$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "new_evidence",
        "new_assumptions"
      ]
    },
    "phase_to": {
      "type": "string",
      "enum": [
        "active"
      ]
    }
  }
}
