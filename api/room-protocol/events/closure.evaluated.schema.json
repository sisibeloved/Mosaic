{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.local/room-protocol/events/closure.evaluated.schema.json",
  "title": "ClosureEvaluatedPayload",
  "description": "收束三态表态（conclude/object/abstain）；qualified 仅对 object——确定性合格性判定（新证据/新假设+预期影响；claim_id 随 RFC-0006 可选）。unavailable 座记 abstain 且 rationale 注明，永不计为同意。",
  "type": "object",
  "required": [
    "closure_id",
    "participant_id",
    "action",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "closure_id": {
      "type": "string",
      "pattern": "^clo_[0-9A-Za-z_-]+$"
    },
    "participant_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "conclude",
        "object",
        "abstain"
      ]
    },
    "claim_id": {
      "type": "string"
    },
    "new_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_impact": {
      "type": "string"
    },
    "qualified": {
      "type": "boolean"
    },
    "parked_reason": {
      "type": "string",
      "enum": [
        "no_new_evidence_or_assumptions",
        "no_expected_impact"
      ]
    },
    "rationale": {
      "type": "string"
    }
  }
}
