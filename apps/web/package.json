{
  "name": "@mosaic/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mosaic 前端 SPA（ADR-0002：React + Vite；经 OpenAPI 生成类型消费 HTTP 契约）",
  "scripts": {
    "gen:api": "openapi-typescript ../../api/http-api/openapi.yaml -o src/api/schema.gen.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
